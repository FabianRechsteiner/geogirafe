{
  "name": "@geogirafe/core",
  "description": "GeoGirafe is a VanillaJS-based library for creating online 2D and 3D geoportals.",
  "author": {
    "name": "GeoGirafe PSC",
    "url": "https://doc.geomapfish.dev"
  },
  "version": "0.3",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/geogirafe/gg-viewer"
  },
  "keywords": [
    "geogirafe",
    "geomapfish",
    "gis",
    "sig",
    "geoportal",
    "map",
    "mapping",
    "2d",
    "3d",
    "openlayers",
    "cesium",
    "geoviewer",
    "webgis",
    "websig"
  ],
  "license": "Apache-2.0",
  "homepage": "https://doc.geomapfish.dev",
  "dependencies": {
    "adjectives": "1.0.2",
    "gridjs": "6.1.1",
    "on-change": "5.0.1",
    "tippy.js": "6.3.7",
    "uhtml": "3.2.2",
    "uuid": "9.0.1",
    "vanilla-picker": "2.12.2"
  },
  "peerDependencies": {
    "cesium": "^1.111.0",
    "@geoblocks/mapfishprint": "^0.1.1",
    "ol": "^8.1.0",
    "ol-mapbox-style": "^12.1.0",
    "olcs": "^2.16.0",
    "proj4": "^2.9.2"
  },
  "devDependencies": {
    "@types/babel__generator": "7.6.8",
    "@types/geojson": "7946.0.13",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/proj4": "2.5.5",
    "@types/uuid": "9.0.7",
    "@typescript-eslint/eslint-plugin": "6.19.1",
    "@typescript-eslint/parser": "6.19.1",
    "cesium": "1.113.0",
    "cross-env": "7.0.3",
    "eslint": "8.56.0",
    "fs-extra": "11.2.0",
    "lint-staged": "15.2.0",
    "magic-string": "0.30.5",
    "ol": "8.2.0",
    "ol-mapbox-style": "12.1.1",
    "olcs": "2.17.0",
    "prettier": "3.2.4",
    "proj4": "2.10.0",
    "typescript": "5.3.3",
    "vite": "5.0.12",
    "vitest": "1.2.1"
  },
  "scripts": {
    "serve": "node buildtools/prebuild.cjs && tsc && vite serve --port 8080",
    "serve-rebundle-deps": "node buildtools/prebuild.cjs && tsc && vite serve --force --port 8080",
    "build": "node buildtools/prebuild.cjs && tsc && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build-docker": "docker build -t geogirafe/viewer -f buildtools/Dockerfile .",
    "test": "vitest",
    "configure-demo": "bash -C './buildtools/configure-demo.sh'",
    "configure-demo-win": "buildtools\\configure-demo.cmd",
    "lint": "eslint src/**/*.ts",
    "pretty": "prettier --write .",
    "tsc": "tsc"
  }
}
