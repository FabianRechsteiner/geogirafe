{
  "name": "@geogirafe/lib-geoportal",
  "description": "GeoGirafe is a flexible application to build online geoportals.",
  "author": {
    "name": "GeoGirafe PSC",
    "url": "https://doc.geomapfish.dev"
  },
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/geogirafe/gg-viewer"
  },
  "keywords": [
    "geogirafe",
    "geomapfish",
    "gis",
    "sig",
    "geoportal",
    "map",
    "mapping",
    "2d",
    "3d",
    "openlayers",
    "cesium",
    "geoviewer",
    "webgis",
    "websig"
  ],
  "license": "Apache-2.0",
  "homepage": "https://doc.geomapfish.dev",
  "dependencies": {
    "@geoblocks/print": "^0.7.5",
    "buffer": "^6.0.3",
    "d3": "7.9.0",
    "file-saver": "2.0.5",
    "gridjs": "6.2.0",
    "lz-string": "1.5.0",
    "on-change": "5.0.1",
    "tippy.js": "6.3.7",
    "uhtml": "4.5.9",
    "uuid": "9.0.1",
    "vanilla-picker": "2.12.3"
  },
  "peerDependencies": {
    "@geoblocks/mapfishprint": "^0.2.13",
    "@types/geojson": "7946.0.14",
    "cesium": "^1.113.0",
    "ol": "^8.1.0",
    "ol-mapbox-style": "^12.1.0",
    "olcs": "^2.16.0",
    "proj4": "^2.9.2"
  },
  "devDependencies": {
    "@geoblocks/mapfishprint": "0.2.14",
    "@types/babel__generator": "7.6.8",
    "@types/d3": "7.4.3",
    "@types/file-saver": "2.0.7",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/proj4": "2.5.5",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "7.10.0",
    "@typescript-eslint/parser": "7.10.0",
    "cesium": "1.117.0",
    "cross-env": "7.0.3",
    "eslint": "8.56.0",
    "font-gis": "1.0.5",
    "fs-extra": "11.2.0",
    "jsdom": "24.1.0",
    "lint-staged": "15.2.5",
    "magic-string": "0.30.10",
    "ol": "9.1.0",
    "ol-mapbox-style": "12.3.2",
    "olcs": "2.20.0",
    "prettier": "3.2.5",
    "proj4": "2.11.0",
    "typescript": "5.4.5",
    "vite": "5.2.11",
    "vite-plugin-static-copy": "1.0.5",
    "vitest": "1.6.0"
  },
  "types": "./main.d.ts",
  "exports": {
    ".": {
      "import": "./main.js"
    },
    "./base": {
      "import": "./base/main.js"
    },
    "./components": {
      "import": "./components/main.js"
    },
    "./models": {
      "import": "./models/main.js"
    },
    "./tools": {
      "import": "./tools/main.js"
    },
    "./vite-inline-templates-plugin": {
      "import": "./buildtools/vite-inline-templates-plugin.js"
    },
    "./vite-restart-plugin": {
      "import": "./buildtools/vite-restart-plugin.js"
    }
  },
  "bin": {
    "lib-inline": "./buildtools/lib-inline.js"
  },
  "files": [
    "**/*"
  ],
  "scripts": {
    "start": "tsc && vite serve --port 8080",
    "start-rebundle-deps": "tsc && vite serve --force --port 8080",
    "build": "node buildtools/app-clean.js && tsc && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview",
    "build-lib": "node buildtools/lib-clean.js && node buildtools/lib-inline.js && node buildtools/lib-collect.js && node buildtools/lib-main-file.js && tsc --project tsconfig.lib.json && node buildtools/lib-finalize.js",
    "publish-lib": "cd dist/lib && npm publish",
    "build-docker": "docker build -t geogirafe/viewer -f buildtools/Dockerfile dist",
    "test": "vitest --run",
    "test-watch": "vitest",
    "configure-demo": "bash -C './buildtools/configure-demo.sh'",
    "configure-demo-win": "buildtools\\configure-demo.cmd",
    "lint": "eslint src/**/*.ts",
    "pretty": "prettier --write .",
    "tsc": "tsc",
    "prepare_commit": "npm run lint && npm run pretty && npm run tsc",
    "check-all": "npm run tsc && npm run lint && npm run test && npm run build && npm run build-lib"
  }
}
