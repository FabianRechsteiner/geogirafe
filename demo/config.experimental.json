{
  "general": {
    "locale": "de-CH"
  },
  "languages": {
    "translations": {
      "de": ["i18n/de.json", "Mock/de.json"],
      "en": ["i18n/en.json", "Mock/en.json"],
      "fr": ["i18n/fr.json", "Mock/fr.json"],
      "it": ["i18n/it.json"]
    },
    "defaultLanguage": "en"
  },
  "interface": {
    "defaultSelectionComponent": "grid"
  },
  "themes": {
    "url": "Mock/themes.json",
    "defaultTheme": "Demo"
  },
  "selection": {
    "maxFeature": 100
  },
  "basemaps": {
    "show": true,
    "defaultBasemap": "OSM map",
    "OSM": true,
    "SwissTopoVectorTiles": true
  },
  "treeview": {
    "useLegendIcons": true
  },
  "search": {
    "url": "https://geomapfish-demo-2-9.camptocamp.com/search?limit=30&partitionlimit=5&interface=experimental&query=###SEARCHTERM###&lang=###SEARCHLANG###",
    "objectPreview": true,
    "layerPreview": true
  },
  "print": {
    "url": "https://geomapfish-demo-2-9.camptocamp.com/printproxy/",
    "formats": ["png", "pdf", "jpg", "jpeg", "notvalid"],
    "defaultFormat": "pdf",
    "layouts": ["1 A4 portrait", "4 A3 landscape"],
    "defaultLayout": "1 A4 portrait",
    "scales": [500000, 25000, 10000, 99999, 5000, 2500],
    "attributeNames": ["legend", "title", "comments"],
    "printLegend": {
      "showGroupsTitle": true
    }
  },
  "share": {
    "service": "lstu",
    "createUrl": "https://lstu.fr/a"
  },
  "projections": {
    "EPSG:3857": "W-M",
    "EPSG:4326": "WGS84",
    "EPSG:2056": "LV95"
  },
  "map": {
    "srid": "EPSG:2056",
    "scales": [1000000, 500000, 200000, 100000, 50000, 20000, 10000, 5000, 2000, 1000, 500, 200],
    "startPosition": "2628597,1186378",
    "startZoom": "3",
    "maxExtent": "2200000,1040000,3000000,1310000"
  },
  "map3d": {
    "terrainUrl": "https://terrain100.geo.admin.ch/1.0.0/ch.swisstopo.terrain.3d/",
    "tilesetsUrls": ["https://vectortiles100.geo.admin.ch/3d-tiles/ch.swisstopo.swisstlm3d.3d/20201020/tileset.json"]
  },
  "bookmarks": {
    "service": "localStorage",
    "get": "",
    "post": ""
  },
  "lidar": {
    "url": "https://sitn.ne.ch/pytree"
  },
  "csv": {
    "separator": ";"
  }
}
