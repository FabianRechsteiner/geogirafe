import { html, fixture, expect } from '@open-wc/testing';
import LanguageComponent from '../src/components/language/component';
import GeoEvents from '../src//models/events';
import I18nManager from '../src/tools/i18nmanager';

describe('LanguageComponent', () => {
  let languageComponent;

  beforeEach(async () => {
    // Read and set the translations (bypass fetch)
    const deTranslations = JSON.parse(fs.readFileSync('./src/static/Mock/de.json', 'utf8'));
    const enTranslations = JSON.parse(fs.readFileSync('./src/static/Mock/en.json', 'utf8'));
    const frTranslations = JSON.parse(fs.readFileSync('./src/static/Mock/fr.json', 'utf8'));
    const i18nManager = I18nManager.getInstance();
    i18nManager.translations['de'] = deTranslations;
    i18nManager.translations['en'] = enTranslations;
    i18nManager.translations['fr'] = frTranslations;

    // Create Element
    component = new LanguageComponent();
    component.setAttribute('default', 'en');
    // Read and set template from local file (bypass fetch)
    const templateFilePath = './src' + component.templateUrl;
    const content = fs.readFileSync(templateFilePath, 'utf8');
    const template = document.createElement('template');
    template.innerHTML = content;
    // Override the default tempalte getter of the element in order to return always the template.
    Object.defineProperty(component, "template", {
      get: function () { return template; }
    });

    /*languageComponent = await fixture(html`
      <girafe-language-select default="en"></girafe-language-select>
    `);*/
  });

  it('should set the default language when rendered', () => {
    expect(I18nManager.getInstance().getDefaultLanguage()).toEqual('en');
  });

  it('should set the text of the menu button to the default language when rendered', () => {
    expect(languageComponent.menuButton.textContent).toEqual('EN');
  });

  it('should change the text of the menu button when the Translate event is fired with action "languageChanged"', () => {
    const event = new CustomEvent(GeoEvents.Translate, { detail: { action: 'languageChanged', language: 'fr' } });
    window.dispatchEvent(event);
    expect(languageComponent.menuButton.textContent).toEqual('FR');
  });

  it('should not change the text of the menu button when the Translate event is fired with an action other than "languageChanged"', () => {
    const event = new CustomEvent(GeoEvents.Translate, { detail: { action: 'otherAction',
    language: 'fr' } });
    window.dispatchEvent(event);
    expect(languageComponent.menuButton.textContent).toEqual('EN');
  });

  it('should set the text of the menu button to the language in the init state when the Init event is fired', () => {
    const event = new CustomEvent(GeoEvents.Init, { detail: { action: 'initState', state: {
    language: 'fr' } } });
    window.dispatchEvent(event);
    expect(languageComponent.menuButton.textContent).toEqual('FR');
  });

  it('should register the onTranslateEvent and onInitEvent functions as event listeners when registerEvents is called', () => {
    const spyTranslate = jest.spyOn(window, 'addEventListener');
    languageComponent.registerEvents();
    expect(spyTranslate).toHaveBeenCalledWith(GeoEvents.Translate, expect.any(Function));
    expect(spyTranslate).toHaveBeenCalledWith(GeoEvents.Init, expect.any(Function));
  });
});